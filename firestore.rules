rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // UTILITY FUNCTIONS (OWASP Access Control & Validation)
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    // Ensures a string is valid and within length bounds
    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }
    // Ensures a string does not contain HTML tags (anti-XSS payload)
    function isPlainText(text) {
      return !text.matches('.*<.*');
    }
    // Ensures field exists and matches type
    function hasOnlyKeys(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }
    function hasAllKeys(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // -------------------------------------------------------------------------
    // PUBLIC READ / ADMIN WRITE COLLECTIONS
    // -------------------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /galleryPhotos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teamMembers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminMeta/{docId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // CLIENT WRITABLE COLLECTIONS (OWASP INJECTION PREVENTION)
    // -------------------------------------------------------------------------
    
    // USERS: Only users can write their own profiles.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Validate schema on write
      allow create, update: if isAdmin() || (
        isSignedIn() && 
        request.auth.uid == userId &&
        (request.resource.data.name == null || (isValidString(request.resource.data.name, 1, 100) && isPlainText(request.resource.data.name))) &&
        (request.resource.data.email == null || (isValidString(request.resource.data.email, 5, 150) && isPlainText(request.resource.data.email))) &&
        (request.resource.data.phone == null || (isValidString(request.resource.data.phone, 0, 20) && isPlainText(request.resource.data.phone))) &&
        (request.resource.data.institution == null || (isValidString(request.resource.data.institution, 0, 150) && isPlainText(request.resource.data.institution)))
      );
      allow delete: if isAdmin();
    }

    // ENROLLMENTS: Users can create pending enrollments for themselves.
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() &&
        request.resource.data.status == "pending_payment" &&
        isValidString(request.resource.data.courseSlug, 1, 100) &&
        isValidString(request.resource.data.courseTitle, 1, 200) &&
        request.resource.data.amount is number && request.resource.data.amount >= 0 &&
        isValidString(request.resource.data.name, 1, 100) && isPlainText(request.resource.data.name) &&
        isValidString(request.resource.data.email, 5, 150) && isPlainText(request.resource.data.email) &&
        isValidString(request.resource.data.phone, 1, 20) && isPlainText(request.resource.data.phone) &&
        request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.email == request.auth.token.email &&
        resource.data.status == "pending_payment" &&
        request.resource.data.status == "pending_verification" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "utrNumber", "updatedAt"]) &&
        request.resource.data.utrNumber is string
      );
      allow delete: if isAdmin();
    }

    // ENQUIRIES: Unauthenticated public contact form.
    match /enquiries/{enquiryId} {
      allow read, update, delete: if isAdmin();
      allow create: if 
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
        isValidString(request.resource.data.name, 1, 100) && isPlainText(request.resource.data.name) &&
        isValidString(request.resource.data.email, 5, 150) && isPlainText(request.resource.data.email) &&
        isValidString(request.resource.data.message, 1, 2000) && isPlainText(request.resource.data.message) &&
        (request.resource.data.phone == null || (isValidString(request.resource.data.phone, 0, 20) && isPlainText(request.resource.data.phone))) &&
        request.resource.data.createdAt is timestamp;
    }

    // NEWSLETTER: Unauthenticated public newsletter form.
    match /newsletterSubscribers/{id} {
      allow read, update, delete: if isAdmin();
      // OWASP Schema & Size Limits
      allow create: if 
        hasAllKeys(['email', 'createdAt']) &&
        isValidString(request.resource.data.email, 5, 150) &&
        request.resource.data.createdAt is timestamp;
    }

  }
}
