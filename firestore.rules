rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Anyone can read course listings; only admins can write.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enrollments: a signed-in user may create their own pending
    // enrollment and read their own records. Only Cloud Functions
    // (admin SDK, bypasses rules) may set status to "confirmed" — the
    // rule below explicitly blocks clients from writing `status`.
    match /enrollments/{enrollmentId} {
      allow create: if request.resource.data.status == "pending_payment";
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update: if false; // only Cloud Functions (Admin SDK) may update
      allow delete: if isAdmin();
    }

    // Public contact-form submissions — anyone can create, only admins read.
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter sign-ups — anyone can create, only admins read.
    match /newsletterSubscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin-only collections for internal notes, broadcast logs, etc.
    match /adminMeta/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
